digraph DFD_InitialLoad {
  rankdir=LR;
  graph [splines=true, nodesep=0.5, ranksep=0.7, fontname="Helvetica", label=<<B>Trading Dashboard — Initial Load (Tickers Workbook)</B><BR/><FONT POINT-SIZE="10">Data Flow Diagram (Gane–Sarson notation)</FONT>>, labelloc="t", labeljust="c"];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#444444"];

  // ================== EXTERNAL ENTITIES (squares) ==================
  subgraph cluster_ext_left {
    label=""; color=invis;
    USER     [shape=box, style="filled,bold", fillcolor="#fff7d6", color="#b45309", label="User\n(Ashok)"];
    XLSX_TIK [shape=box3d, style=filled, fillcolor="#e0f2fe", color="#075985",
              label="Tickers YYYY-MM-DD.xlsx\n(34-tab workbook)"];
    XLSX_LF  [shape=box3d, style=filled, fillcolor="#e0f2fe", color="#075985",
              label="LoadFiles.xlsx\n(file-type schedule)"];
  }

  // ================== PROCESSES (rounded rectangles) ==================
  P1 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>1. tickers_initial_load</B><BR/>orchestrator<BR/><FONT POINT-SIZE="9">step_a + step_b</FONT>>];

  P2 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>2. load_raw</B><BR/>per-tab generic loader<BR/><FONT POINT-SIZE="9">openpyxl → DB</FONT>>];

  P3 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>3. custom loaders</B><BR/>load_data_tab_*<BR/>load_trig_rules<BR/>load_parm/hquad/hqds<BR/>load_etfchg/iichg/sss/ssl>];

  P4 [shape=box, style="filled,rounded", fillcolor="#dcfce7", color="#15803d",
      label=<<B>4. derive_all(D)</B><BR/>15-step derive pipeline<BR/><FONT POINT-SIZE="9">tl→td→tw→call→etf→ii→ssh→ssl→sss→ma→dash→stks→summary→missing→trig</FONT>>];

  P5 [shape=box, style="filled,rounded", fillcolor="#fef9c3", color="#a16207",
      label=<<B>5. eval_atomic_rule</B><BR/>jump | linear | sigmoid<BR/><FONT POINT-SIZE="9">composite aggregation</FONT>>];

  // ================== DATA STORES (open-ended rectangles) ==================
  D_REF  [shape=cylinder, style=filled, fillcolor="#f3e8ff", color="#6b21a8",
          label="D1. ref_*\n(17 lookup tables)"];
  D_HIST [shape=cylinder, style=filled, fillcolor="#fce7f3", color="#9d174d",
          label="D2. hist_*\n(17 history tables, append-only)"];
  D_DRV  [shape=cylinder, style=filled, fillcolor="#dcfce7", color="#15803d",
          label="D3. drv_*\n(15 derived tables)"];
  D_META [shape=cylinder, style=filled, fillcolor="#e5e7eb", color="#374151",
          label="D4. meta_*\nmeta_etl_run\nmeta_file_processed\nmeta_derived_run"];
  D_RULES[shape=cylinder, style=filled, fillcolor="#fef3c7", color="#92400e",
          label="D5. ref_trig_atomic_rule\nref_trig_composite_mapping"];

  // ================== FLOWS ==================
  USER     -> P1 [label="run command"];
  XLSX_TIK -> P1 [label="open workbook\n(parse YYYY-MM-DD)"];
  XLSX_LF  -> P1 [label="load_loadfiles"];

  P1 -> P2 [label="REF_MAPS\n(Sctr,RRT,Desc,ISMH)"];
  P1 -> P2 [label="HIST_MAPS\n(Y,TL,TD,TW,TO,RR,II,...)"];
  P1 -> P3 [label="data tabs\nTrig, Parm, HQuad, etfchg, iichg"];

  P2 -> D_REF  [label="ON CONFLICT\nDO NOTHING\n(ref_*)"];
  P2 -> D_HIST [label="batch=1000\nON CONFLICT\nDO NOTHING\n(hist_*)"];
  P3 -> D_REF  [label="holiday/econ/blackout/\ncalendar/asset_alloc/rules"];
  P3 -> D_HIST [label="hist_etfchg/iichg"];
  P3 -> D_RULES[label="atomic + composite\ndefinitions"];

  P2 -> D_META [label="meta_etl_run\nopen/update/close"];
  P3 -> D_META [label="meta_etl_run\nopen/update/close"];
  P1 -> D_META [label="meta_file_processed\nSHA-256 dedupe"];

  P1 -> P4 [label="step_b_derive(D)"];

  D_HIST  -> P4 [label="latest ≤ D\nper hist_*"];
  D_REF   -> P4 [label="lookups\noutlook→weight\nsector"];
  D_RULES -> P5 [label="atomic + composite"];
  D_DRV   -> P4 [label="re-read intermediate\ndrv_tl,drv_td,drv_tw"];

  P4 -> P5 [label="for each (D, symbol)\nfor each rule"];
  P5 -> D_DRV [label="drv_stks.triggered_*\ndrv_trig (long)"];
  P4 -> D_DRV [label="DELETE WHERE\nas_of_date=D\nthen INSERT"];
  P4 -> D_META[label="meta_derived_run"];

  P4 -> USER [label="counts\nlogs\n(stdout)", style=dashed, color="#6b7280"];

  { rank=same; XLSX_TIK; XLSX_LF; }
  { rank=same; D_REF; D_HIST; D_RULES; }
  { rank=same; P2; P3; }
}
