digraph Architecture {
  rankdir=TB;
  graph [splines=true, nodesep=0.4, ranksep=0.5, fontname="Helvetica", label=<<B>Trading Dashboard — Component Architecture</B>>, labelloc="t"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded"];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_data {
    label="Data Sources"; style=filled; fillcolor="#fff7ed"; color="#9a3412";
    XLSX_TIK [fillcolor="#fed7aa", label="Tickers\n2026-MM-DD.xlsx"];
    XLSX_LF  [fillcolor="#fed7aa", label="LoadFiles.xlsx"];
    XLSX_FEEDS [fillcolor="#fed7aa", label="17 daily/weekly feeds\n(Y, TL, TD, RR, II, ...)"];
  }

  subgraph cluster_etl {
    label="ETL Pipeline (Python)"; style=filled; fillcolor="#eff6ff"; color="#1d4ed8";
    SCHED   [fillcolor="#bfdbfe", label="scheduler.py\n(watchdog)"];
    INIT    [fillcolor="#bfdbfe", label="tickers_initial_load.py"];
    LOAD    [fillcolor="#bfdbfe", label="etl_load.py\n(single file)"];
    REFRESH [fillcolor="#bfdbfe", label="refresh_ref.py\n(UPSERT tunable refs)"];
    LOAD_RAW[fillcolor="#bfdbfe", label="load_raw.py\n+ custom handlers"];
    DERIVE  [fillcolor="#bbf7d0", label="derive.py\n+ derive_v2.py overrides"];
    OUTCOMES[fillcolor="#bbf7d0", label="compute_outcomes.py"];
    CLEAN   [fillcolor="#fde68a", label="cleanup.py\n(retention)"];
  }

  subgraph cluster_db {
    label="PostgreSQL 17 — trading"; style=filled; fillcolor="#f5f3ff"; color="#6b21a8";
    REF  [shape=cylinder, fillcolor="#ddd6fe", label="ref_*  (17)"];
    HIST [shape=cylinder, fillcolor="#fbcfe8", label="hist_* (17)"];
    DRV  [shape=cylinder, fillcolor="#bbf7d0", label="drv_*  (15)"];
    META [shape=cylinder, fillcolor="#e5e7eb", label="meta_*  (5)"];
    UA   [shape=cylinder, fillcolor="#fde68a", label="user_action_log\ndrv_rule_outcome"];
    VIEWS[shape=note, fillcolor="#ede9fe", label="v_dash, v_stks, v_ma,\nv_dash_summary,\nv_available_dates,\nv_rule_performance"];
  }

  subgraph cluster_api {
    label="FastAPI (uvicorn :8000)"; style=filled; fillcolor="#fef3c7"; color="#92400e";
    API  [fillcolor="#fde68a", label="api/main.py\n+ api/models.py"];
  }

  subgraph cluster_web {
    label="Frontend (vanilla JS + Chart.js)"; style=filled; fillcolor="#ecfdf5"; color="#065f46";
    DASH  [fillcolor="#a7f3d0", label="/  Dashboard"];
    COCK  [fillcolor="#a7f3d0", label="/cockpit\nAction Cockpit"];
    RULES [fillcolor="#a7f3d0", label="/rules\nRules Manager"];
    PERF  [fillcolor="#a7f3d0", label="/rule-performance"];
    EXPL  [fillcolor="#a7f3d0", label="/explore\nData Explorer"];
    REFUI [fillcolor="#a7f3d0", label="/ref\nRef Maintenance"];
    TRIG  [fillcolor="#a7f3d0", label="/trig\nTrig Analyzer"];
  }

  XLSX_TIK -> INIT;
  XLSX_LF  -> INIT;
  XLSX_FEEDS -> SCHED;
  SCHED  -> LOAD;
  LOAD   -> LOAD_RAW;
  INIT   -> LOAD_RAW;
  LOAD_RAW -> HIST;
  LOAD_RAW -> REF;
  REFRESH -> REF;
  LOAD   -> DERIVE [label="do_derive=True"];
  INIT   -> DERIVE [label="step_b"];
  DERIVE -> DRV;
  DERIVE -> HIST [style=dashed, label="reads"];
  DERIVE -> REF  [style=dashed, label="reads"];
  OUTCOMES -> UA;
  UA -> OUTCOMES [style=dashed];
  CLEAN -> HIST [label="DELETE old"];
  CLEAN -> META;

  REF -> VIEWS [style=dashed];
  DRV -> VIEWS [style=dashed];
  UA  -> VIEWS [style=dashed];

  API -> VIEWS;
  API -> REF;
  API -> DRV;
  API -> UA;
  API -> REFRESH [label="POST /api/ref/{t}/reload"];

  DASH -> API;
  COCK -> API;
  RULES -> API;
  PERF -> API;
  EXPL -> API;
  REFUI -> API;
  TRIG -> API;
}
