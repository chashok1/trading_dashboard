digraph DFD_OngoingLoad {
  rankdir=LR;
  graph [splines=true, nodesep=0.5, ranksep=0.7, fontname="Helvetica", label=<<B>Trading Dashboard — Ongoing Load (Watchdog Scheduler)</B><BR/><FONT POINT-SIZE="10">Data Flow Diagram (Gane–Sarson notation)</FONT>>, labelloc="t", labeljust="c"];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#444444"];

  // ================== EXTERNAL ENTITIES ==================
  USER [shape=box, style="filled,bold", fillcolor="#fff7d6", color="#b45309", label="User\n(downloads files\nor manual CLI)"];
  FS   [shape=folder, style=filled, fillcolor="#e0f2fe", color="#075985",
        label="17 source folders\nC:\\Ashok\\Investing\\Stocks\\<TYPE>\\Archive\\\n(*.xlsx daily/weekly)"];
  WORKING [shape=folder, style=filled, fillcolor="#fef9c3", color="#a16207",
        label="etl/working/\n(staging copies)"];
  WEB [shape=box, style="filled,bold", fillcolor="#fff7d6", color="#b45309", label="Browser\n(dashboard)"];

  // ================== PROCESSES ==================
  P1 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>1. scheduler</B><BR/>watchdog observer<BR/><FONT POINT-SIZE="9">debounce 3s + quiesce 2s</FONT>>];

  P2 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>2. etl_load.load_one_file</B><BR/>parse date/file_type<BR/>SHA-256 dedupe<BR/>copy → working/<BR/>dispatch handler>];

  P3 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>3. mapping dispatch</B><BR/>HIST_MAPS lookup<BR/>or CUSTOM_HANDLERS<BR/><FONT POINT-SIZE="9">etfchg, iichg, sss, ssl, ref_tickers</FONT>>];

  P4 [shape=box, style="filled,rounded", fillcolor="#dbeafe", color="#1d4ed8",
      label=<<B>4. load_one_tab</B><BR/>generic loader<BR/><FONT POINT-SIZE="9">batch=1000\nON CONFLICT DO NOTHING</FONT>>];

  P5 [shape=box, style="filled,rounded", fillcolor="#dcfce7", color="#15803d",
      label=<<B>5. derive_all(file_dt)</B><BR/>per-date rebuild<BR/><FONT POINT-SIZE="9">15-step pipeline</FONT>>];

  P6 [shape=box, style="filled,rounded", fillcolor="#fef9c3", color="#a16207",
      label=<<B>6. FastAPI</B><BR/>uvicorn :8000<BR/><FONT POINT-SIZE="9">/api/dash, /api/stks, /api/data/...</FONT>>];

  // ================== DATA STORES ==================
  D_REF  [shape=cylinder, style=filled, fillcolor="#f3e8ff", color="#6b21a8",
          label="D1. ref_load_files\n(scheduler config)"];
  D_HIST [shape=cylinder, style=filled, fillcolor="#fce7f3", color="#9d174d",
          label="D2. hist_*"];
  D_DRV  [shape=cylinder, style=filled, fillcolor="#dcfce7", color="#15803d",
          label="D3. drv_ma, drv_dash,\ndrv_stks, drv_trig, ..."];
  D_META [shape=cylinder, style=filled, fillcolor="#e5e7eb", color="#374151",
          label="D4. meta_etl_run\nmeta_file_processed\nmeta_derived_run"];
  D_RULES[shape=cylinder, style=filled, fillcolor="#fef3c7", color="#92400e",
          label="D5. ref_trig_atomic_rule\nref_trig_composite_mapping\nref_param"];

  // ================== FLOWS ==================
  USER -> FS [label="save Excel\nexport"];
  FS -> P1 [label="watchdog\nFile-created\nevent"];
  D_REF -> P1 [label="watched dirs\n(per ref_load_files)"];

  P1 -> P2 [label="path, file_type"];
  P2 -> D_META [label="lookup\nmeta_file_processed\n(SHA-256)", color="#6b21a8"];
  P2 -> WORKING[label="shutil.copy2\n(never delete original)"];
  P2 -> D_REF  [label="lookup_target_tab\nfrom ref_load_files"];

  P2 -> P3 [label="open workbook\n+ target_tab"];
  P3 -> P4 [label="HIST_MAPS\n(generic mapping)"];
  P3 -> D_HIST [label="custom: etfchg/iichg/sss/ssl\ndirect inserts"];
  P3 -> D_RULES[label="custom: ref_tickers\n→ refresh_ref.run_all"];

  P4 -> D_HIST [label="INSERT batches\nlive meta updates"];
  P4 -> D_META [label="meta_etl_run\nrows_inserted\nrows_skipped"];
  P2 -> D_META [label="mark_processed\n(SHA-256)"];

  P2 -> P5 [label="if do_derive\nfresh session"];
  D_HIST -> P5 [label="latest ≤ file_dt"];
  D_REF  -> P5 [label="lookups"];
  D_RULES-> P5 [label="rules"];
  P5 -> D_DRV  [label="DELETE WHERE\nas_of_date=file_dt\nthen INSERT"];
  P5 -> D_META [label="meta_derived_run"];

  WEB -> P6 [label="HTTP\n/api/dash?date=D\n/api/stks?date=D"];
  P6 -> D_DRV [label="v_dash(D)\nv_stks(D)\nv_dash_summary(D)"];
  P6 -> D_REF [label="reference lookups"];
  P6 -> WEB   [label="JSON\nrendered table\ncharts", style=dashed];

  { rank=same; FS; WORKING; }
  { rank=same; D_REF; D_HIST; D_DRV; D_RULES; }
}
