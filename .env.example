# Copy this file to .env and fill in PG_PASSWORD before running setup.bat.
# All other values have sensible defaults from config/settings.py and are
# optional; uncomment only the ones you need to override.

# --- Required ---
PG_PASSWORD=changeme

# --- PostgreSQL connection (defaults shown) ---
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=trading
# PG_USER=postgres

# --- Source files ---
# Absolute path to the master Tickers workbook used by the initial-load script.
# TICKERS_FILE=C:\path\to\Tickers 2026-05-12.xlsx
# Absolute path to the LoadFiles workbook (used by tickers_initial_load).
# LOADFILES_FILE=C:\path\to\LoadFiles.xlsx

# --- ETL ---
# Directory where the scheduler copies inbound xlsx files before loading.
# Defaults to <repo>/etl/working.
# ETL_WORKING_DIR=

# Retention default (days) for tables that don't override in meta_cleanup_policy.
# DEFAULT_RETENTION_DAYS=365

# --- API ---
# API_HOST=127.0.0.1
# API_PORT=8000

# --- Macro feed (FRED) ---
# Free API key for economic data + EOD index levels (etl/fetch_macro.py).
# Get one in ~30s at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_key_here
