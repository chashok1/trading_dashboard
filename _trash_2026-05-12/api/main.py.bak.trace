"""
FastAPI app for Trading Dashboard.

Endpoints (all read-only):
  GET /health
  GET /api/dates
  GET /api/dash?date=YYYY-MM-DD&section=Stock
  GET /api/dash/summary?date=YYYY-MM-DD
  GET /api/stks?date=YYYY-MM-DD&sector=Information+Technology&min_brr=0
  GET /api/symbol/{sym}/history?from=YYYY-MM-DD&to=YYYY-MM-DD
  GET /api/sectors                # distinct sector values currently in drv_ma
  GET /                           # serves web/index.html
  GET /static/*                   # serves web/* (js, css, etc.)

Run from project root:
  .venv\\Scripts\\activate
  uvicorn api.main:app --reload --host 127.0.0.1 --port 8000
"""
from __future__ import annotations

import json
from datetime import date, datetime
from pathlib import Path
from typing import Optional

from fastapi import FastAPI, HTTPException, Query, File, UploadFile
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from sqlalchemy import text
import tempfile
import os

from config.settings import settings
from etl.db import get_engine, get_table, session_scope
from etl.refresh_ref import REFRESH_HANDLERS

from api.models import (
    DashRow, DashSummary, HealthResponse, StksRow, SymbolHistoryRow,
    RefTableColumn, RefTableData, RefTableMeta, RefRowUpdateResult, RefReloadResult,
    DataTableMeta, RefRowInsertResult, TableStats,
    AtomicRuleResponse, CompositeRuleResponse, UserActionRequest, RulePerformanceRow,
    AtomicRuleCreateRequest, AtomicRuleUpdateRequest,
    CompositeRuleCreateRequest, CompositeRuleUpdateRequest,
)

PROJECT_ROOT = Path(__file__).resolve().parent.parent
WEB_DIR = PROJECT_ROOT / "web"


app = FastAPI(
    title="Trading Dashboard API",
    description="Replaces the Tickers Excel workbook. Snapshot-date aware.",
    version="0.1.0",
)

# Permissive CORS for local dev. Tighten in production.
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# -----------------------------------------------------------------------------
# Health
# -----------------------------------------------------------------------------

@app.get("/debug/tables-dict")
def debug_tables_dict():
    """Debug endpoint: show what's actually in DATA_TABLE_DATE_COL"""
    return {
        "total": len(DATA_TABLE_DATE_COL),
        "drv_cat_count": len([k for k in DATA_TABLE_DATE_COL if k.startswith('drv_cat_')]),
        "drv_cat_tables": sorted([k for k in DATA_TABLE_DATE_COL if k.startswith('drv_cat_')]),
        "all_tables": sorted(DATA_TABLE_DATE_COL.keys()),
    }


@app.get("/health", response_model=HealthResponse)
def health():
    db_ok = "ok"
    try:
        with get_engine().connect() as conn:
            conn.execute(text("SELECT 1"))
    except Exception as e:
        db_ok = f"error: {e}"
    return HealthResponse(
        status="ok" if db_ok == "ok" else "degraded",
        db=db_ok,
        server_time=datetime.now(),
        pg_database=settings.pg_database,
    )


# -----------------------------------------------------------------------------
# Date listing
# -----------------------------------------------------------------------------

@app.get("/api/dates")
def list_dates():
    """Distinct snapshot dates available across drv_dash + drv_stks."""
    with session_scope() as s:
        rows = s.execute(text("""
            SELECT as_of_date FROM v_available_dates ORDER BY 1 DESC
        """)).fetchall()
    return [r[0].isoformat() for r in rows]


@app.get("/api/sectors")
def list_sectors():
    """Distinct sectors present in drv_ma (used for filter dropdowns)."""
    with session_scope() as s:
        rows = s.execute(text("""
            SELECT DISTINCT sector FROM drv_ma
            WHERE sector IS NOT NULL
            ORDER BY 1
        """)).fetchall()
    return [r[0] for r in rows]


# -----------------------------------------------------------------------------
# Dashboard endpoints
# -----------------------------------------------------------------------------

def _resolve_date(d: Optional[str]) -> date:
    """If date is None, return latest available; else parse YYYY-MM-DD."""
    if d is None:
        with session_scope() as s:
            row = s.execute(text(
                "SELECT MAX(as_of_date) FROM v_available_dates"
            )).first()
        if not row or row[0] is None:
            raise HTTPException(status_code=404,
                                detail="No data loaded. Run etl/tickers_initial_load.py first.")
        return row[0]
    try:
        return datetime.strptime(d, "%Y-%m-%d").date()
    except ValueError:
        raise HTTPException(status_code=400,
                            detail="date must be YYYY-MM-DD")


@app.get("/api/dash", response_model=list[DashRow])
def get_dash(
    date: Optional[str] = Query(None, description="Snapshot date (default = latest)"),
    section: Optional[str] = Query(None, description="Filter to one section"),
):
    d = _resolve_date(date)
    sql = "SELECT * FROM v_dash(:d)"
    params = {"d": d}
    if section:
        sql = "SELECT * FROM v_dash(:d) WHERE section = :sec"
        params["sec"] = section
    with session_scope() as s:
        rows = s.execute(text(sql), params).mappings().all()
    return rows


@app.get("/api/dash/summary", response_model=Optional[DashSummary])
def get_dash_summary(date: Optional[str] = Query(None)):
    d = _resolve_date(date)
    with session_scope() as s:
        row = s.execute(text("SELECT * FROM v_dash_summary(:d)"),
                        {"d": d}).mappings().first()
    if not row:
        return None
    return row


# -----------------------------------------------------------------------------
# Dashboard side panels: economic indicators, earnings/calendar events, quads
# -----------------------------------------------------------------------------

@app.get("/api/dashboard/econ-indicators")
def get_dashboard_econ_indicators(
    date: Optional[str] = Query(None, description="As-of date (defaults to today)"),
    limit: int = Query(30, ge=1, le=200),
):
    """
    Active economic indicators for the dashboard side panel.
    Mirrors Dash A-J: filters ref_econ_indicator where show_on_dashboard='Y'
    (or incl='Y' as fallback), sorted by days ascending (soonest first).
    """
    d = datetime.strptime(date, "%Y-%m-%d").date() if date else datetime.now().date()
    with session_scope() as s:
        rows = s.execute(text("""
            SELECT
                indicator,
                indicator_date,
                (indicator_date - :d) AS days,
                ol AS signal,
                from_date,
                to_date,
                effective_today,
                expected,
                url
            FROM ref_econ_indicator
            WHERE COALESCE(show_on_dashboard, incl) = 'Y'
              AND indicator_date >= :d - INTERVAL '7 days'
            ORDER BY indicator_date ASC, days ASC
            LIMIT :lim
        """), {"d": d, "lim": limit}).mappings().all()
    return [dict(r) for r in rows]


@app.get("/api/dashboard/earnings")
def get_dashboard_earnings(
    date: Optional[str] = Query(None, description="As-of date (defaults to today)"),
    days_ahead: int = Query(60, ge=1, le=365),
    limit: int = Query(100, ge=1, le=500),
):
    """
    Earnings & calendar events for the dashboard side panel.
    Pulls from ref_calendar_event (Vix Expiration, Fed Meeting, CPI, NFP, etc.)
    plus any rows tagged 'Earnings' in the category column.
    Sorted by event_date ascending, next `days_ahead` days only.
    """
    d = datetime.strptime(date, "%Y-%m-%d").date() if date else datetime.now().date()
    with session_scope() as s:
        rows = s.execute(text("""
            SELECT
                category,
                event_date,
                (event_date - :d) AS days_until
            FROM ref_calendar_event
            WHERE event_date >= :d
              AND event_date <= :d + (:days_ahead || ' days')::INTERVAL
            ORDER BY event_date ASC, category ASC
            LIMIT :lim
        """), {"d": d, "days_ahead": days_ahead, "lim": limit}).mappings().all()
    return [dict(r) for r in rows]


@app.get("/api/dashboard/quads")
def get_dashboard_quads(
    date: Optional[str] = Query(None, description="As-of date (defaults to today)"),
):
    """
    Quads for the dashboard banner:
      - current_quarter: quarter containing :d
      - next_quarter:    quarter immediately after current_quarter
      - months:          list of 4 monthly periods (current month + next 3)
    All resolved from ref_quad_periods.
    """
    d = datetime.strptime(date, "%Y-%m-%d").date() if date else datetime.now().date()
    out = {
        "as_of_date": d.isoformat(),
        "current_quarter": None,
        "next_quarter": None,
        "months": [],
    }
    with session_scope() as s:
        cq = s.execute(text("""
            SELECT period_type, label, start_date, end_date, quad
            FROM ref_quad_periods
            WHERE period_type = 'quarterly'
              AND :d >= start_date
              AND (:d <= end_date OR end_date IS NULL)
            ORDER BY start_date DESC
            LIMIT 1
        """), {"d": d}).mappings().first()
        if cq:
            out["current_quarter"] = dict(cq)

        anchor = cq["start_date"] if cq else d
        nq = s.execute(text("""
            SELECT period_type, label, start_date, end_date, quad
            FROM ref_quad_periods
            WHERE period_type = 'quarterly'
              AND start_date > :anchor
            ORDER BY start_date ASC
            LIMIT 1
        """), {"anchor": anchor}).mappings().first()
        if nq:
            out["next_quarter"] = dict(nq)

        months = s.execute(text("""
            SELECT period_type, label, start_date, end_date, quad
            FROM ref_quad_periods
            WHERE period_type = 'monthly'
              AND COALESCE(end_date, start_date) >= :d
            ORDER BY start_date ASC
            LIMIT 4
        """), {"d": d}).mappings().all()
        out["months"] = [dict(m) for m in months]

    return out


@app.get("/api/stks", response_model=list[StksRow])
def get_stks(
    date: Optional[str] = Query(None),
    sector: Optional[str] = Query(None),
    asset_class: Optional[str] = Query(None),
    min_brr: Optional[float] = Query(None, description="Filter rr_brr >= this"),
    max_brr: Optional[float] = Query(None, description="Filter rr_brr <= this"),
    outlook: Optional[str] = Query(None, description="BULLISH | BEARISH | NEUTRAL"),
    limit: int = Query(500, ge=1, le=5000),
):
    d = _resolve_date(date)
    where = []
    params: dict = {"d": d, "lim": limit}
    if sector:
        where.append("sector = :sector"); params["sector"] = sector
    if asset_class:
        where.append("asset_class = :ac"); params["ac"] = asset_class
    if min_brr is not None:
        where.append("rr_brr >= :minbrr"); params["minbrr"] = min_brr
    if max_brr is not None:
        where.append("rr_brr <= :maxbrr"); params["maxbrr"] = max_brr
    if outlook:
        where.append("UPPER(composite_label) = :ol"); params["ol"] = outlook.upper()

    where_clause = " AND ".join(["ma.as_of_date = :d"] + where) if where else "ma.as_of_date = :d"
    sql = f"""
        SELECT
            ma.as_of_date, ma.symbol, ma.description, ma.sector, ma.asset_class,
            ma.sub_asset_class, ma.equity_sector, ma.last_price, ma.a_trend_value, ma.a_trade_value,
            ma.a_bb_top, ma.a_bb_bottom, ma.a_bb_streak, ma.a_macd_brr, ma.a_macdh_d_brr,
            ma.pct_brr, ma.rr_outlook, ma.rr_brr, ma.call_outlook, ma.call_modifier,
            ma.etf_outlook, ma.ii_outlook, ma.ssh_signal_sign, ma.iv_percentile, ma.imp_volatility,
            ma.hv_percentile, ma.range_compression, ma.d_iv_to_hv, ma.rsi, ma.earnings_days,
            ma.sma_20, ma.sma_50, ma.sma_200, ma.volume, ma.vlm_projected, ma.market_cap_str,
            ma.beta, ma.pe_ratio, ma.eps, ma.div_yield,
            stks.composite_outlook, stks.composite_label,
            stks.triggered_atomic_ids, stks.triggered_composite_ids
        FROM drv_ma ma
        LEFT JOIN drv_stks stks ON ma.as_of_date = stks.as_of_date AND ma.symbol = stks.symbol
        WHERE {where_clause}
        ORDER BY ma.symbol
        LIMIT :lim
    """
    with session_scope() as s:
        rows = s.execute(text(sql), params).mappings().all()
    return rows


@app.get("/api/symbol/{sym}/history", response_model=list[SymbolHistoryRow])
def get_symbol_history(
    sym: str,
    from_date: Optional[str] = Query(None, alias="from"),
    to_date: Optional[str] = Query(None, alias="to"),
    limit: int = Query(365, ge=1, le=2000),
):
    sym = sym.upper().strip()
    where = ["symbol = :sym"]
    params: dict = {"sym": sym, "lim": limit}
    if from_date:
        try:
            params["fd"] = datetime.strptime(from_date, "%Y-%m-%d").date()
            where.append("as_of_date >= :fd")
        except ValueError:
            raise HTTPException(status_code=400, detail="from must be YYYY-MM-DD")
    if to_date:
        try:
            params["td"] = datetime.strptime(to_date, "%Y-%m-%d").date()
            where.append("as_of_date <= :td")
        except ValueError:
            raise HTTPException(status_code=400, detail="to must be YYYY-MM-DD")
    sql = f"""
        SELECT as_of_date, last_price, rr_brr, pct_brr, rr_outlook, sector
        FROM drv_ma
        WHERE {' AND '.join(where)}
        ORDER BY as_of_date DESC
        LIMIT :lim
    """
    with session_scope() as s:
        rows = s.execute(text(sql), params).mappings().all()
    if not rows:
        raise HTTPException(status_code=404,
                            detail=f"no history for symbol '{sym}'")
    return rows


# -----------------------------------------------------------------------------
# Ref Table Management
# -----------------------------------------------------------------------------

# All known ref tables (17 total)
ALL_REF_TABLES = [
    "ref_sector", "ref_rrt", "ref_rule_desc", "ref_holiday", "ref_econ_indicator",
    "ref_fed_blackout", "ref_calendar_event", "ref_quad_outlook", "ref_quad_periods",
    "ref_param", "ref_param_lookup", "ref_asset_allocation", "ref_load_files",
    "ref_ismh", "ref_trig_atomic_rule", "ref_trig_composite_mapping",
]

# Table-to-sheet mapping for header validation during file upload reload
REF_TABLE_SHEET = {
    "ref_sector": "Sctr",
    "ref_rule_desc": "Desc",
    "ref_ismh": "ISMH",
}


@app.get("/api/ref/tables", response_model=list[RefTableMeta])
def list_ref_tables():
    """List all ref tables with row counts and tunable status."""
    result = []
    with session_scope() as s:
        for tbl_name in ALL_REF_TABLES:
            try:
                count_row = s.execute(text(f"SELECT COUNT(*) FROM {tbl_name}")).first()
                row_count = count_row[0] if count_row else 0
            except Exception:
                row_count = 0
            tunable = tbl_name in REFRESH_HANDLERS
            result.append(RefTableMeta(
                name=tbl_name,
                row_count=row_count,
                tunable=tunable,
            ))
    return result


@app.get("/api/ref/{table_name}", response_model=RefTableData)
def get_ref_table(
    table_name: str,
    limit: int = Query(500, ge=1, le=5000),
    offset: int = Query(0, ge=0),
):
    """Fetch ref table data with column metadata."""
    if table_name not in ALL_REF_TABLES:
        raise HTTPException(status_code=404, detail=f"Unknown ref table: {table_name}")

    with session_scope() as s:
        # Get column info via SQLAlchemy reflection
        table = get_table(table_name)
        pk_cols = {c.name for c in table.primary_key.columns}
        columns = [
            RefTableColumn(name=c.name, is_pk=(c.name in pk_cols))
            for c in table.columns
            if c.name != "loaded_at"  # Always hide loaded_at
        ]

        # Fetch rows
        rows_sql = f"SELECT * FROM {table_name} ORDER BY 1 LIMIT :lim OFFSET :off"
        row_list = s.execute(text(rows_sql), {"lim": limit, "off": offset}).mappings().all()
        rows = [dict(r) for r in row_list]

        # Get total count
        count_row = s.execute(text(f"SELECT COUNT(*) FROM {table_name}")).first()
        total = count_row[0] if count_row else 0

    return RefTableData(
        table=table_name,
        columns=columns,
        rows=rows,
        total=total,
    )


@app.patch("/api/ref/{table_name}/row", response_model=RefRowUpdateResult)
def update_ref_row(
    table_name: str,
    pk: dict,
    updates: dict,
):
    """Update a single row in a ref table."""
    if table_name not in ALL_REF_TABLES:
        raise HTTPException(status_code=404, detail=f"Unknown ref table: {table_name}")

    with session_scope() as s:
        table = get_table(table_name)
        pk_cols = {c.name for c in table.primary_key.columns}

        # Validate PK keys match schema
        if set(pk.keys()) != pk_cols:
            raise HTTPException(
                status_code=400,
                detail=f"PK mismatch: expected {list(pk_cols)}, got {list(pk.keys())}"
            )

        # Build WHERE clause from PK
        where_parts = [f"{k} = :{k}" for k in pk_cols]
        where_sql = " AND ".join(where_parts)

        # Build SET clause, always include loaded_at
        update_params = {**pk}
        set_parts = []
        for col_name, col_val in updates.items():
            if col_name in pk_cols or col_name == "loaded_at":
                continue  # Skip PKs and loaded_at
            set_parts.append(f"{col_name} = :{col_name}")
            update_params[col_name] = col_val

        if not set_parts:
            return RefRowUpdateResult(ok=True, updated=0)

        set_parts.append("loaded_at = now()")

        update_sql = f"UPDATE {table_name} SET {', '.join(set_parts)} WHERE {where_sql}"

        try:
            result = s.execute(text(update_sql), update_params)
            updated = result.rowcount or 0
            return RefRowUpdateResult(ok=True, updated=updated)
        except Exception as e:
            raise HTTPException(status_code=500, detail=f"Update failed: {str(e)}")


@app.post("/api/ref/{table_name}/reload", response_model=RefReloadResult)
async def reload_ref_table(table_name: str, file: UploadFile = File(...)):
    """Reload a ref table from an uploaded Excel file."""
    if table_name not in ALL_REF_TABLES:
        raise HTTPException(status_code=404, detail=f"Unknown ref table: {table_name}")

    if table_name not in REFRESH_HANDLERS:
        raise HTTPException(
            status_code=400,
            detail=f"Table '{table_name}' is not tunable (read-only from Excel)"
        )

    tmp_path = None
    try:
        from openpyxl import load_workbook
        from etl.refresh_ref import run_one

        # Save uploaded file to temp location
        with tempfile.NamedTemporaryFile(suffix='.xlsx', delete=False) as tmp:
            tmp_path = tmp.name
            content = await file.read()
            tmp.write(content)

        # Open workbook and detect sheet
        wb = load_workbook(tmp_path)
        expected_sheet = REF_TABLE_SHEET.get(table_name)
        sheet_name = None

        if expected_sheet and expected_sheet in wb.sheetnames:
            sheet_name = expected_sheet
        elif len(wb.sheetnames) == 1:
            sheet_name = wb.sheetnames[0]
        else:
            if expected_sheet:
                raise ValueError(f"Cannot find expected sheet '{expected_sheet}' in uploaded file. Available sheets: {', '.join(wb.sheetnames)}")
            else:
                raise ValueError(f"Unable to determine which sheet to use. Workbook has multiple sheets: {', '.join(wb.sheetnames)}")

        # Validate column headers for known mappings
        if table_name in REF_TABLE_SHEET:
            from etl.mappings import REF_MAPS
            sheet_key = REF_TABLE_SHEET[table_name]
            if sheet_key in REF_MAPS:
                mapping = REF_MAPS[sheet_key]
                expected_headers = {col[0] for col in mapping.get("columns", [])}

                sheet = wb[sheet_name]
                actual_headers = set()
                for cell in sheet[1]:
                    if cell.value:
                        actual_headers.add(str(cell.value).strip())

                missing = expected_headers - actual_headers
                if missing:
                    raise ValueError(f"Missing required columns: {', '.join(sorted(missing))}")

        # Run the refresh handler
        rows_read, rows_inserted, rows_skipped = run_one(table_name, tmp_path)
        return RefReloadResult(
            ok=True,
            table=table_name,
            rows_read=rows_read,
            rows_inserted=rows_inserted,
            rows_skipped=rows_skipped,
        )
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Reload failed: {str(e)}")
    finally:
        if tmp_path and os.path.exists(tmp_path):
            os.remove(tmp_path)


@app.post("/api/ref/{table_name}/insert", response_model=RefRowInsertResult)
def insert_ref_row(table_name: str, row: dict):
    """Insert a new row into a ref table. Returns error if PK already exists."""
    if table_name not in ALL_REF_TABLES:
        raise HTTPException(status_code=404, detail=f"Unknown ref table: {table_name}")

    try:
        from sqlalchemy.dialects.postgresql import insert as pg_insert

        with session_scope() as s:
            table = get_table(table_name)
            pk_cols = {c.name for c in table.primary_key.columns}

            # Validate PK fields are present
            if not all(col in row for col in pk_cols):
                raise HTTPException(
                    status_code=400,
                    detail=f"Missing PK fields: {sorted(pk_cols - set(row.keys()))}"
                )

            # Build INSERT with ON CONFLICT DO NOTHING
            stmt = pg_insert(table).values([row]).on_conflict_do_nothing()
            result = s.execute(stmt)

            n_inserted = result.rowcount if result.rowcount and result.rowcount > 0 else 0
            if n_inserted == 0:
                raise HTTPException(
                    status_code=409,
                    detail="Row already exists (duplicate primary key)"
                )

            return RefRowInsertResult(ok=True, inserted=n_inserted)
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Insert failed: {str(e)}")


