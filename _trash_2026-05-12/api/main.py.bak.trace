DATA_TABLE_DATE_COL: dict[str, str | None] = {
    # hist_* — snapshot_date
    "hist_y": "snapshot_date", "hist_tl": "snapshot_date", "hist_td": "snapshot_date",
    "hist_tw": "snapshot_date", "hist_to": "snapshot_date", "hist_rr": "snapshot_date",
    "hist_call": "snapshot_date", "hist_etf": "snapshot_date", "hist_ii": "snapshot_date",
    "hist_ssh": "snapshot_date", "hist_psrk": "snapshot_date", "hist_ps5": "snapshot_date",
    "hist_pstn": "snapshot_date", "hist_f": "snapshot_date", "hist_cs": "snapshot_date",
    "hist_etfchg": "event_date", "hist_iichg": "event_date",
    # drv_* — snapshot_date or as_of_date
    "drv_tl": "snapshot_date", "drv_td": "snapshot_date", "drv_tw": "snapshot_date",
    "drv_call": "snapshot_date", "drv_etf": "snapshot_date", "drv_ii": "snapshot_date",
    "drv_ssh": "snapshot_date", "drv_ssl": "as_of_date", "drv_sss": "as_of_date",
    "drv_ps": "as_of_date", "drv_ma": "as_of_date", "drv_dash": "as_of_date",
    "drv_stks": "as_of_date", "drv_dash_summary": "as_of_date", "drv_trig": "as_of_date",
    "drv_missing_symbols": "as_of_date",
    # drv_cat_* — as_of_date (concept-based category tables)
    "drv_cat_action_decision": "as_of_date", "drv_cat_atomic_input": "as_of_date",
    "drv_cat_bollinger": "as_of_date", "drv_cat_composite": "as_of_date",
    "drv_cat_earnings": "as_of_date", "drv_cat_etf": "as_of_date",
    "drv_cat_fundamentals": "as_of_date", "drv_cat_he_outlook": "as_of_date",
    "drv_cat_holdings_dollars": "as_of_date", "drv_cat_identity": "as_of_date",
    "drv_cat_ii": "as_of_date", "drv_cat_index_volatility": "as_of_date",
    "drv_cat_macd": "as_of_date", "drv_cat_moving_avg": "as_of_date",
    "drv_cat_perf_extremes": "as_of_date", "drv_cat_price": "as_of_date",
    "drv_cat_ps": "as_of_date", "drv_cat_quad_outlook": "as_of_date",
    "drv_cat_risk_range": "as_of_date", "drv_cat_rsi": "as_of_date",
    "drv_cat_sector_rollup": "as_of_date", "drv_cat_signal_strength": "as_of_date",
    "drv_cat_trend_trade": "as_of_date", "drv_cat_trig_summary": "as_of_date",
    "drv_cat_volatility_regime": "as_of_date", "drv_cat_volume": "as_of_date",
    # meta_* — varies
    "meta_etl_run": "started_at",
    "meta_file_processed": "file_date",
    "meta_cleanup_policy": None,
    "meta_cleanup_history": "run_at",
    "meta_derived_run": "as_of_date",
}

print(f"[DEBUG] DATA_TABLE_DATE_COL loaded with {len(DATA_TABLE_DATE_COL)} entries")
print(f"[DEBUG] drv_cat_* count: {len([k for k in DATA_TABLE_DATE_COL if k.startswith('drv_cat_')])}")


@app.get("/api/data/tables", response_model=list[DataTableMeta])
def list_data_tables():
    """List all non-ref tables with row counts and date column info."""
    result = []
    with session_scope() as s:
        for table_name, date_col in sorted(DATA_TABLE_DATE_COL.items()):
            try:
                count_row = s.execute(text(f"SELECT COUNT(*) FROM {table_name}")).first()
                row_count = count_row[0] if count_row else 0
            except Exception:
                row_count = 0
            # Categorize: hist, drv, drv2, drv_cat, ref, meta, other
            if table_name.startswith("drv_cat_"):
                category = "drv_cat"
            elif table_name.startswith("drv2_"):
                category = "drv2"
            elif table_name.startswith("drv_"):
                category = "drv"
            elif table_name.startswith("hist_"):
                category = "hist"
            elif table_name.startswith("ref_"):
                category = "ref"
            elif table_name.startswith("meta_"):
                category = "meta"
            else:
                category = "other"
            result.append(DataTableMeta(
                name=table_name,
                category=category,
                row_count=row_count,
                date_col=date_col,
            ))
    return result


@app.get("/api/stats/tables", response_model=list[TableStats])
def stats_tables(date: Optional[str] = Query(None)):
    """Get row count stats for all tables, optionally filtered by date."""
    try:
        d = _resolve_date(date)
    except HTTPException:
        # No data loaded yet - use a default date for filtering
        d = None
    results = []
    with session_scope() as s:
        # Non-ref tables (hist_*, drv_*, meta_*) with date filtering
        for table_name, date_col in sorted(DATA_TABLE_DATE_COL.items()):
            try:
                if date_col:
                    sql = f"""
                        SELECT COUNT(*) AS total,
                               COUNT(DISTINCT {date_col}) AS distinct_dates,
                               MIN({date_col})::text AS min_date,
                               MAX({date_col})::text AS max_date,
                               SUM(CASE WHEN {date_col}::date = :d THEN 1 ELSE 0 END) AS rows_on_date
                        FROM {table_name}
                    """
                    row = s.execute(text(sql), {"d": d}).mappings().one()
                    rows_on_date = int(row["rows_on_date"]) if row["rows_on_date"] else 0
                    distinct_dates = int(row["distinct_dates"]) if row["distinct_dates"] else 0
                else:
                    sql = f"SELECT COUNT(*) AS total FROM {table_name}"
                    row = s.execute(text(sql)).mappings().one()
                    rows_on_date = None
                    distinct_dates = None

                # Categorize
                if table_name.startswith("drv_cat_"):
                    category = "drv_cat"
                elif table_name.startswith("drv_"):
                    category = "drv"
                elif table_name.startswith("hist_"):
                    category = "hist"
                elif table_name.startswith("meta_"):
                    category = "meta"
                else:
                    category = "other"

                results.append(TableStats(
                    name=table_name,
                    category=category,
                    date_col=date_col,
                    total_rows=int(row["total"]),
                    rows_on_date=rows_on_date,
                    distinct_dates=distinct_dates,
                    min_date=row.get("min_date"),
                    max_date=row.get("max_date"),
                ))
            except Exception as e:
                # Log but continue on table errors
                print(f"Error querying {table_name}: {e}")

        # Ref tables (no date filtering)
        for table_name in ALL_REF_TABLES:
            try:
                cnt_row = s.execute(text(f"SELECT COUNT(*) FROM {table_name}")).first()
                row_count = cnt_row[0] if cnt_row else 0
                results.append(TableStats(
                    name=table_name,
                    category="ref",
                    date_col=None,
                    total_rows=row_count,
                    rows_on_date=None,
                    distinct_dates=None,
                    min_date=None,
                    max_date=None,
                ))
            except Exception as e:
                print(f"Error querying {table_name}: {e}")

    return sorted(results, key=lambda r: (r.category, r.name))


@app.get("/api/data/{table_name}", response_model=RefTableData)
def get_data_table(
    table_name: str,
    date: Optional[str] = Query(None),
    limit: int = Query(200, ge=1, le=5000),
    offset: int = Query(0, ge=0),
    sort_by: Optional[str] = Query(None),
    sort_dir: Optional[str] = Query("asc", pattern="^(asc|desc)$"),
):
    """Fetch data from any non-ref table using dashboard date with table-specific logic and optional sorting."""
    if table_name not in DATA_TABLE_DATE_COL:
        raise HTTPException(status_code=404, detail=f"Unknown table: {table_name}")

    date_col = DATA_TABLE_DATE_COL[table_name]
    d = _resolve_date(date) if date_col else None

    with session_scope() as s:
        table = get_table(table_name)
        pk_cols = {c.name for c in table.primary_key.columns}
        columns = [
            RefTableColumn(name=c.name, is_pk=(c.name in pk_cols))
            for c in table.columns
            if c.name not in {"loaded_at", "computed_at"}
        ]

        where_clause = ""
        params: dict = {"lim": limit, "off": offset}

        if date_col and d:
            is_timestamp = str(table.columns[date_col].type).startswith("TIMESTAMP")
            date_cast = f"{date_col}::date" if is_timestamp else date_col

            # Table-specific date filter logic
            if table_name in ("hist_y", "hist_tl", "hist_td", "hist_tw", "drv_tl", "drv_td", "drv_tw"):
                # Exact date match
                where_clause = f"WHERE {date_cast} = :d"
                params["d"] = d
            elif table_name in ("hist_to", "hist_rr", "hist_f", "hist_cs", "hist_etf", "hist_ii", "hist_psrk", "hist_ssh"):
                # Pick MAX date where date < dashboard date
                max_date_sql = f"SELECT MAX({date_cast}) FROM {table_name} WHERE {date_cast} < :d"
                max_date_result = s.execute(text(max_date_sql), {"d": d}).scalar()
                if max_date_result:
                    where_clause = f"WHERE {date_cast} = :max_d"
                    params["max_d"] = max_date_result
                else:
                    where_clause = "WHERE 1=0"  # No data available
            elif table_name == "hist_etfchg":
                # Pick MAX date where date < dashboard date (ETF change history)
                max_date_sql = f"SELECT MAX({date_cast}) FROM {table_name} WHERE {date_cast} < :d"
                max_date_result = s.execute(text(max_date_sql), {"d": d}).scalar()
                if max_date_result:
                    where_clause = f"WHERE {date_cast} = :max_d"
                    params["max_d"] = max_date_result
                else:
                    where_clause = "WHERE 1=0"
            elif table_name == "hist_iichg":
                # Pick MAX date where date < dashboard date (II change history)
                max_date_sql = f"SELECT MAX({date_cast}) FROM {table_name} WHERE {date_cast} < :d"
                max_date_result = s.execute(text(max_date_sql), {"d": d}).scalar()
                if max_date_result:
                    where_clause = f"WHERE {date_cast} = :max_d"
                    params["max_d"] = max_date_result
                else:
                    where_clause = "WHERE 1=0"
            elif table_name == "hist_call":
                # Last 7 days from dashboard date
                from datetime import timedelta
                d_minus_7 = d - timedelta(days=7)
                where_clause = f"WHERE {date_cast} >= :d_minus_7 AND {date_cast} <= :d"
                params["d"] = d
                params["d_minus_7"] = d_minus_7
            elif table_name in ("drv_call", "drv_etf", "drv_ii", "drv_ssh"):
                # Pick MAX date where date <= dashboard date (latest derived table snapshot)
                max_date_sql = f"SELECT MAX({date_cast}) FROM {table_name} WHERE {date_cast} <= :d"
                max_date_result = s.execute(text(max_date_sql), {"d": d}).scalar()
                if max_date_result:
                    where_clause = f"WHERE {date_cast} = :max_d"
                    params["max_d"] = max_date_result
                else:
                    where_clause = "WHERE 1=0"

        # Determine ORDER BY clause
        if sort_by:
            # Validate sort_by is a valid column
            col_names = {c.name for c in table.columns}
            if sort_by not in col_names:
                raise HTTPException(status_code=400, detail=f"Invalid sort column: {sort_by}")
            order_clause = f"ORDER BY {sort_by} {sort_dir.upper()} NULLS LAST"
        else:
            # Default: order by primary key(s) for consistent pagination
            pk_order = ", ".join([c.name for c in table.primary_key.columns])
            order_clause = f"ORDER BY {pk_order}"

        rows_sql = f"SELECT * FROM {table_name} {where_clause} {order_clause} LIMIT :lim OFFSET :off"
        row_list = s.execute(text(rows_sql), params).mappings().all()
        rows = [dict(r) for r in row_list]

        count_sql = f"SELECT COUNT(*) FROM {table_name} {where_clause}"
        count_row = s.execute(text(count_sql), params).first()
        total = count_row[0] if count_row else 0

    return RefTableData(
        table=table_name,
        columns=columns,
        rows=rows,
        total=total,
    )


